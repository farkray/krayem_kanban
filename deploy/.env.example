# Copia a .env en el VPS (/opt/kanban/.env) y rellena. No lo subas a git.
DOMAIN=kanban.midominio.com

# Usuario inicial (se crea en el primer arranque). Contraseña de 10+ caracteres.
ADMIN_EMAIL=tu@correo.com
ADMIN_PASSWORD=

# ¿Cualquiera puede registrarse desde la pantalla de acceso? Para uso personal: false.
ALLOW_SIGNUP=false

# Lo escribe deploy.sh en cada despliegue (versión de las imágenes en uso).
TAG=latest

# Solo para pruebas locales (en el VPS déjalos en 80 y 443).
# HTTP_PORT=80
# HTTPS_PORT=443
